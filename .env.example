# Copia este archivo como `.env.local` y completa los valores.
# `.env.local` esta ignorado por git (patron `*.local` en .gitignore).
#
# Usa SIEMPRE la anon key (publishable). La `service_role` key NUNCA debe
# aparecer en un archivo VITE_*: Vite la incrustaria en el bundle publico.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-keys
